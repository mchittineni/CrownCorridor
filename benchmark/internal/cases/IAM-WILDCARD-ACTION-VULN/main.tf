# IaCSecBench case IAM-WILDCARD-ACTION-VULN
# Control : IAM_WILDCARD_ACTION (Identity policy action scope)
# Expected: VIOLATION
# Rationale: Policy grants Action '*' on Resource '*'.
#
# Generated by benchmark/generate_corpus.py. Edit the specification
# there rather than this file, so the vulnerable/compliant pair stays
# minimal and the annotation stays consistent.

terraform {
  required_version = ">= 1.9.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

resource "aws_s3_bucket" "target" {
  bucket = "${var.name_prefix}-iam-scope-${var.environment}"
}

resource "aws_iam_policy" "target" {
  name = "${var.name_prefix}-iam-wildcard"

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = "*"
      Resource = "*"
    }]
  })
}
