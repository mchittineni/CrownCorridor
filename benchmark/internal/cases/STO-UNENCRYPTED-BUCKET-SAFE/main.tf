# IaCSecBench case STO-UNENCRYPTED-BUCKET-SAFE
# Control : STO_UNENCRYPTED_BUCKET (Object storage encryption at rest)
# Expected: COMPLIANT
# Rationale: Bucket encryption uses a customer-managed KMS key.
#
# Generated by benchmark/generate_corpus.py. Edit the specification
# there rather than this file, so the vulnerable/compliant pair stays
# minimal and the annotation stays consistent.

terraform {
  required_version = ">= 1.9.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

resource "aws_s3_bucket" "target" {
  bucket = "${var.name_prefix}-sto-enc-${var.environment}"
}

resource "aws_kms_key" "target" {
  description             = "Benchmark key"
  enable_key_rotation     = true
  deletion_window_in_days = 7
}

resource "aws_s3_bucket_server_side_encryption_configuration" "target" {
  bucket = aws_s3_bucket.target.id

  rule {
    apply_server_side_encryption_by_default {
      kms_master_key_id = aws_kms_key.target.arn
      sse_algorithm     = "aws:kms"
    }
  }
}
