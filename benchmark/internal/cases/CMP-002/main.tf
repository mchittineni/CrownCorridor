# Benchmark Case: CMP-002 - Compute & Container Security Benchmark Scenario #02 (PASS)
# Difficulty: Medium | Category: CMP

terraform {
  required_version = ">= 1.15.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.56.0"
    }
  }
}

locals {
  environment = "benchmark"
  case_id     = "CMP-002"
}

resource "aws_cmp_resource" "target" {
  name = "target-${local.case_id}"
  tags = {
    Environment = local.environment
    ManagedBy   = "IaCSecBench"
  }
}
