# Benchmark Case: SRV-003 - Serverless Lambda & API Gateway Benchmark Scenario #03 (FAIL)
# Difficulty: Hard | Category: SRV

terraform {
  required_version = ">= 1.15.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.56.0"
    }
  }
}

locals {
  environment = "benchmark"
  case_id     = "SRV-003"
}

resource "aws_srv_resource" "target" {
  name = "target-${local.case_id}"
  tags = {
    Environment = local.environment
    ManagedBy   = "IaCSecBench"
  }
}
