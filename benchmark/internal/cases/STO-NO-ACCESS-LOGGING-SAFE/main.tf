# IaCSecBench case STO-NO-ACCESS-LOGGING-SAFE
# Control : STO_NO_ACCESS_LOGGING (Object storage access logging)
# Expected: COMPLIANT
# Rationale: Access logging is directed to a dedicated log bucket.
#
# Generated by benchmark/generate_corpus.py. Edit the specification
# there rather than this file, so the vulnerable/compliant pair stays
# minimal and the annotation stays consistent.

terraform {
  required_version = ">= 1.9.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

resource "aws_s3_bucket" "logs" {
  bucket = "${var.name_prefix}-sto-logs-${var.environment}"
}

resource "aws_s3_bucket" "target" {
  bucket = "${var.name_prefix}-sto-log-${var.environment}"
}

resource "aws_s3_bucket_logging" "target" {
  bucket        = aws_s3_bucket.target.id
  target_bucket = aws_s3_bucket.logs.id
  target_prefix = "access/"
}
