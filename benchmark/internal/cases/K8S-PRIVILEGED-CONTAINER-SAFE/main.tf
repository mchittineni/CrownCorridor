# IaCSecBench case K8S-PRIVILEGED-CONTAINER-SAFE
# Control : K8S_PRIVILEGED_CONTAINER (Container privileged mode)
# Expected: COMPLIANT
# Rationale: Container runs unprivileged.
#
# Generated by benchmark/generate_corpus.py. Edit the specification
# there rather than this file, so the vulnerable/compliant pair stays
# minimal and the annotation stays consistent.

terraform {
  required_version = ">= 1.9.0"
  required_providers {
    kubernetes = {
      source  = "hashicorp/kubernetes"
      version = "~> 2.0"
    }
  }
}

resource "kubernetes_pod" "target" {
  metadata {
    name      = "${var.name_prefix}-k8s-privileged"
    namespace = var.environment
  }

  spec {
    container {
      name  = "app"
      image = "nginx:1.27.3"

      security_context {
        privileged = false
      }

      resources {
        limits = {
          cpu    = "500m"
          memory = "512Mi"
        }
      }
    }
  }
}
