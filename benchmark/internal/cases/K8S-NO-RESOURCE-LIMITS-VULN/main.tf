terraform {
  required_version = ">= 1.9.0"
  required_providers {
    kubernetes = {
      source  = "hashicorp/kubernetes"
      version = "~> 2.0"
    }
  }
}

resource "kubernetes_pod" "target" {
  metadata {
    name      = "${var.name_prefix}-k8s-limits"
    namespace = var.environment
  }

  spec {
    container {
      name  = "app"
      image = "nginx:1.27.3"

      security_context {
        privileged = false
      }
    }
  }
}
