# IaCSecBench case CMP-NO-IMAGE-SCANNING-VULN
# Control : CMP_NO_IMAGE_SCANNING (Container registry image scanning)
# Expected: VIOLATION
# Rationale: Repository does not scan images on push.
#
# Generated by benchmark/generate_corpus.py. Edit the specification
# there rather than this file, so the vulnerable/compliant pair stays
# minimal and the annotation stays consistent.

terraform {
  required_version = ">= 1.9.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

resource "aws_ecr_repository" "target" {
  name                 = "${var.name_prefix}-cmp-scan"
  image_tag_mutability = "IMMUTABLE"

  image_scanning_configuration {
    scan_on_push = false
  }
}
