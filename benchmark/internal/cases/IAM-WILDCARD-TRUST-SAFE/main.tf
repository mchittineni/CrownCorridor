# IaCSecBench case IAM-WILDCARD-TRUST-SAFE
# Control : IAM_WILDCARD_TRUST (Role trust policy principal scope)
# Expected: COMPLIANT
# Rationale: Trust policy allows sts:AssumeRole from a named service principal.
#
# Generated by benchmark/generate_corpus.py. Edit the specification
# there rather than this file, so the vulnerable/compliant pair stays
# minimal and the annotation stays consistent.

terraform {
  required_version = ">= 1.9.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

resource "aws_iam_role" "target" {
  name = "${var.name_prefix}-iam-trust"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Action    = "sts:AssumeRole"
      Principal = { Service = "ecs-tasks.amazonaws.com" }
    }]
  })
}
