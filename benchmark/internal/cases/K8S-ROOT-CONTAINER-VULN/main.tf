# IaCSecBench case K8S-ROOT-CONTAINER-VULN
# Control : K8S_ROOT_CONTAINER (Root container admission)
# Expected: VIOLATION
# Rationale: Policy admits containers running as any user, including root.
#
# Generated by benchmark/generate_corpus.py. Edit the specification
# there rather than this file, so the vulnerable/compliant pair stays
# minimal and the annotation stays consistent.

terraform {
  required_version = ">= 1.9.0"
  required_providers {
    kubernetes = {
      source  = "hashicorp/kubernetes"
      version = "~> 2.0"
    }
  }
}

resource "kubernetes_pod_security_policy" "target" {
  metadata {
    name = "${var.name_prefix}-k8s-root"
  }

  spec {
    privileged                 = false
    allow_privilege_escalation = false

    run_as_user {
      rule = "RunAsAny"
    }

    fs_group {
      rule = "RunAsAny"
    }

    supplemental_groups {
      rule = "RunAsAny"
    }

    se_linux {
      rule = "RunAsAny"
    }
  }
}
