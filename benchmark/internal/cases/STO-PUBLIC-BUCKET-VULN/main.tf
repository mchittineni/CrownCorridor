# IaCSecBench case STO-PUBLIC-BUCKET-VULN
# Control : STO_PUBLIC_BUCKET (Object storage public access block)
# Expected: VIOLATION
# Rationale: All four public access block flags are disabled.
#
# Generated by benchmark/generate_corpus.py. Edit the specification
# there rather than this file, so the vulnerable/compliant pair stays
# minimal and the annotation stays consistent.

terraform {
  required_version = ">= 1.9.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

locals {
  bucket_name = "${var.name_prefix}-sto-public-${var.environment}"
}

resource "aws_s3_bucket" "target" {
  bucket = local.bucket_name
}

resource "aws_s3_bucket_public_access_block" "target" {
  bucket                  = aws_s3_bucket.target.id
  block_public_acls       = false
  block_public_policy     = false
  ignore_public_acls      = false
  restrict_public_buckets = false
}
