# IaCSecBench case ENC-UNENCRYPTED-VOLUME-VULN
# Control : ENC_UNENCRYPTED_VOLUME (Block storage encryption at rest)
# Expected: VIOLATION
# Rationale: EBS volume is created unencrypted.
#
# Generated by benchmark/generate_corpus.py. Edit the specification
# there rather than this file, so the vulnerable/compliant pair stays
# minimal and the annotation stays consistent.

terraform {
  required_version = ">= 1.9.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

resource "aws_kms_key" "target" {
  description             = "Benchmark volume key"
  enable_key_rotation     = true
  deletion_window_in_days = 7
}

resource "aws_ebs_volume" "target" {
  availability_zone = "eu-west-2a"
  size              = 8
  encrypted         = false
}
