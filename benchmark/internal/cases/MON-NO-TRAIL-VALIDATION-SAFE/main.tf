# IaCSecBench case MON-NO-TRAIL-VALIDATION-SAFE
# Control : MON_NO_TRAIL_VALIDATION (Audit trail log file validation)
# Expected: COMPLIANT
# Rationale: Trail has log file integrity validation enabled.
#
# Generated by benchmark/generate_corpus.py. Edit the specification
# there rather than this file, so the vulnerable/compliant pair stays
# minimal and the annotation stays consistent.

terraform {
  required_version = ">= 1.9.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

resource "aws_s3_bucket" "trail" {
  bucket = "${var.name_prefix}-mon-val-${var.environment}"
}

resource "aws_kms_key" "trail" {
  description             = "Benchmark trail key"
  enable_key_rotation     = true
  deletion_window_in_days = 7
}

resource "aws_cloudtrail" "target" {
  name                          = "${var.name_prefix}-mon-val"
  s3_bucket_name                = aws_s3_bucket.trail.id
  kms_key_id                    = aws_kms_key.trail.arn
  is_multi_region_trail         = true
  enable_log_file_validation    = true
}
