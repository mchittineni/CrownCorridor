# IaCSecBench case CMP-MUTABLE-IMAGE-TAGS-VULN
# Control : CMP_MUTABLE_IMAGE_TAGS (Container registry tag immutability)
# Expected: VIOLATION
# Rationale: Repository permits mutable image tags.
#
# Generated by benchmark/generate_corpus.py. Edit the specification
# there rather than this file, so the vulnerable/compliant pair stays
# minimal and the annotation stays consistent.

terraform {
  required_version = ">= 1.9.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

resource "aws_ecr_repository" "target" {
  name                 = "${var.name_prefix}-cmp-tags"
  image_tag_mutability = "MUTABLE"

  image_scanning_configuration {
    scan_on_push = true
  }
}
