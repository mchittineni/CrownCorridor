# IaCSecBench case SEC-HARDCODED-CREDENTIAL-VULN
# Control : SEC_HARDCODED_CREDENTIAL (Embedded credential material)
# Expected: VIOLATION
# Rationale: Function environment embeds a literal credential value.
#
# Generated by benchmark/generate_corpus.py. Edit the specification
# there rather than this file, so the vulnerable/compliant pair stays
# minimal and the annotation stays consistent.

terraform {
  required_version = ">= 1.9.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

resource "aws_iam_role" "target" {
  name = "${var.name_prefix}-sec-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Action    = "sts:AssumeRole"
      Principal = { Service = "lambda.amazonaws.com" }
    }]
  })
}

resource "aws_lambda_function" "target" {
  function_name = "${var.name_prefix}-sec-cred"
  role          = aws_iam_role.target.arn
  handler       = "index.handler"
  runtime       = "python3.12"
  filename      = "function.zip"

  environment {
    variables = {
      DB_PASSWORD = "SuperSecretP4ssw0rd!"
    }
  }
}
