# IaCSecBench case STO-PUBLIC-DATABASE-VULN
# Control : STO_PUBLIC_DATABASE (Managed database public accessibility)
# Expected: VIOLATION
# Rationale: Database instance is publicly accessible.
#
# Generated by benchmark/generate_corpus.py. Edit the specification
# there rather than this file, so the vulnerable/compliant pair stays
# minimal and the annotation stays consistent.

terraform {
  required_version = ">= 1.9.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

resource "aws_db_instance" "target" {
  identifier                  = "${var.name_prefix}-net-db"
  allocated_storage           = 20
  engine                      = "postgres"
  instance_class              = "db.t3.micro"
  username                    = "benchmark"
  manage_master_user_password = true
  skip_final_snapshot         = true
  storage_encrypted           = true
  publicly_accessible         = true
}
