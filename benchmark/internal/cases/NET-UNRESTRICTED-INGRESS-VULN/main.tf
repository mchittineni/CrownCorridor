# IaCSecBench case NET-UNRESTRICTED-INGRESS-VULN
# Control : NET_UNRESTRICTED_INGRESS (Unrestricted network ingress)
# Expected: VIOLATION
# Rationale: Security group permits SSH ingress from 0.0.0.0/0.
#
# Generated by benchmark/generate_corpus.py. Edit the specification
# there rather than this file, so the vulnerable/compliant pair stays
# minimal and the annotation stays consistent.

terraform {
  required_version = ">= 1.9.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

locals {
  ingress_cidrs = ["0.0.0.0/0"]
}

resource "aws_vpc" "target" {
  cidr_block = "10.0.0.0/16"
}

resource "aws_security_group" "target" {
  name        = "${var.name_prefix}-net-ingress"
  description = "Benchmark ingress group"
  vpc_id      = aws_vpc.target.id

  dynamic "ingress" {
    for_each = local.ingress_cidrs
    content {
      description = "SSH"
      from_port   = 22
      to_port     = 22
      protocol    = "tcp"
      cidr_blocks = [ingress.value]
    }
  }

  egress {
    description = "All outbound"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}
