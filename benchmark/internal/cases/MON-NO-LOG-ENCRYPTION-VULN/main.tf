# IaCSecBench case MON-NO-LOG-ENCRYPTION-VULN
# Control : MON_NO_LOG_ENCRYPTION (Audit log encryption)
# Expected: VIOLATION
# Rationale: Trail logs are not encrypted with a customer-managed key.
#
# Generated by benchmark/generate_corpus.py. Edit the specification
# there rather than this file, so the vulnerable/compliant pair stays
# minimal and the annotation stays consistent.

terraform {
  required_version = ">= 1.9.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

resource "aws_s3_bucket" "trail" {
  bucket = "${var.name_prefix}-mon-enc-${var.environment}"
}

resource "aws_cloudtrail" "target" {
  name                       = "${var.name_prefix}-mon-enc"
  s3_bucket_name             = aws_s3_bucket.trail.id
  enable_log_file_validation = true
  is_multi_region_trail      = true
}
