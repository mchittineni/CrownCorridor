# Benchmark Case: ID-002 - Federated Identity & SAML/OIDC Benchmark Scenario #02 (PASS)
# Difficulty: Medium | Category: ID

terraform {
  required_version = ">= 1.15.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.56.0"
    }
  }
}

locals {
  environment = "benchmark"
  case_id     = "ID-002"
}

resource "aws_id_resource" "target" {
  name = "target-${local.case_id}"
  tags = {
    Environment = local.environment
    ManagedBy   = "IaCSecBench"
  }
}
