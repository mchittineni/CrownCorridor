# Benchmark Case: SEC-001 - Zero Hardcoded Secrets & SSM Benchmark Scenario #01 (FAIL)
# Difficulty: Easy | Category: SEC

terraform {
  required_version = ">= 1.15.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.56.0"
    }
  }
}

locals {
  environment = "benchmark"
  case_id     = "SEC-001"
}

resource "aws_sec_resource" "target" {
  name = "target-${local.case_id}"
  tags = {
    Environment = local.environment
    ManagedBy   = "IaCSecBench"
  }
}
