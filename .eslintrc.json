{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "globals": {
    "L": "readonly",
    "Chart": "readonly",
    "pmtiles": "readonly",
    "maplibregl": "readonly",
    "portal": "writable"
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "rules": {
    "indent": "off",
    "quotes": ["error", "single", { "avoidEscape": true, "allowTemplateLiterals": true }],
    "semi": ["error", "always"],
    "no-unused-vars": ["warn", { "args": "none" }],
    "no-console": "off",
    "eqeqeq": ["error", "always"],
    "curly": ["error", "multi-line"]
  }
}
