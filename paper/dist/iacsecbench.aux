\newlabel{tab:performance}{{III}{8}{Detection performance on the admissible corpus ($N = 48$: 26 vulnerable, 22 compliant). Intervals are exact Clopper--Pearson at the 95\% level. Entries marked n/e are not estimable from this corpus}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Exact McNemar comparisons against OPA (plan-level). $b$ counts cases the reference classifies correctly and the comparator does not, counting both missed violations and spurious findings; $c$ is the converse. $p$ is the two-sided exact binomial value, $p_{\text  {adj}}$ its Holm--Bonferroni correction across the tool family. The odds ratio carries a Haldane--Anscombe correction so that a zero discordant cell yields a finite estimate.}}{8}{table.4}\protected@file@percent }
\newlabel{tab:mcnemar}{{IV}{8}{Exact McNemar comparisons against OPA (plan-level). $b$ counts cases the reference classifies correctly and the comparator does not, counting both missed violations and spurious findings; $c$ is the converse. $p$ is the two-sided exact binomial value, $p_{\text {adj}}$ its Holm--Bonferroni correction across the tool family. The odds ratio carries a Haldane--Anscombe correction so that a zero discordant cell yields a finite estimate}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {V}{\ignorespaces Exact McNemar comparisons over every tool pair, with Holm--Bonferroni applied across the full set of pairs rather than across one tool's family. $b$ counts cases the left tool classifies correctly and the right does not; $c$ is the converse. Both error types count. The correction is stronger here than in Table\nobreakspace  {}\ref  {tab:mcnemar} because the family is larger.}}{8}{table.5}\protected@file@percent }
\newlabel{tab:allpairs}{{V}{8}{Exact McNemar comparisons over every tool pair, with Holm--Bonferroni applied across the full set of pairs rather than across one tool's family. $b$ counts cases the left tool classifies correctly and the right does not; $c$ is the converse. Both error types count. The correction is stronger here than in Table~\ref {tab:mcnemar} because the family is larger}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VI}{\ignorespaces Recall under three finding-matching criteria. \emph  {Control} credits a detection only when the tool's rule maps to the control the case violates; \emph  {resource} credits any finding on the expected resource; \emph  {any} credits any finding whatsoever. The spread measures attribution precision.}}{8}{table.6}\protected@file@percent }
\newlabel{tab:strictness}{{VI}{8}{Recall under three finding-matching criteria. \emph {Control} credits a detection only when the tool's rule maps to the control the case violates; \emph {resource} credits any finding on the expected resource; \emph {any} credits any finding whatsoever. The spread measures attribution precision}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VII}{\ignorespaces Measured per-case execution latency over 3 repetitions. Values are mean $\pm $ standard deviation on the environment recorded in \texttt  {results/run\_manifest.json}. Each tool is measured at its own interface: the plan-level figure covers policy evaluation over an already-compiled plan document and excludes the \texttt  {terraform init} and \texttt  {terraform plan} invocations that produce it, which dominate that layer's wall-clock cost in continuous integration. It is therefore a lower bound, and is not comparable with the source-level figures, which have no equivalent preparation step.}}{8}{table.7}\protected@file@percent }
\newlabel{tab:latency}{{VII}{8}{Measured per-case execution latency over 3 repetitions. Values are mean $\pm $ standard deviation on the environment recorded in \texttt {results/run\_manifest.json}. Each tool is measured at its own interface: the plan-level figure covers policy evaluation over an already-compiled plan document and excludes the \texttt {terraform init} and \texttt {terraform plan} invocations that produce it, which dominate that layer's wall-clock cost in continuous integration. It is therefore a lower bound, and is not comparable with the source-level figures, which have no equivalent preparation step}{table.7}{}}
