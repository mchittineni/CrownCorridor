{
  "name": "crown-corridor",
  "version": "1.0.0",
  "description": "Next-generation real estate and property discovery portal for Andhra Pradesh & Telangana.",
  "scripts": {
    "docs": "npx jsdoc -c jsdoc.json",
    "lint": "eslint app/portal.js",
    "format": "prettier --write \"app/**/*.{js,css,html}\" \"*.json\" \"**/*.md\"",
    "format:check": "prettier --check \"app/**/*.{js,css,html}\" \"*.json\" \"**/*.md\""
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "docdash": "^2.0.2",
    "eslint": "^10.8.0",
    "jsdoc": "^4.0.5",
    "prettier": "^3.9.6"
  }
}
