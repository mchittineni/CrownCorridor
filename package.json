{
  "name": "iacsecbench",
  "version": "1.0.0",
  "description": "An Open Framework and Empirical Benchmark for Evaluating Infrastructure-as-Code Security Gates",
  "scripts": {
    "docs": "npx jsdoc -c jsdoc.json",
    "lint": "eslint application/app/portal.js",
    "format": "prettier --write \"application/app/**/*.{js,css,html}\" \"*.json\" \"**/*.md\"",
    "format:check": "prettier --check \"application/app/**/*.{js,css,html}\" \"*.json\" \"**/*.md\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "docdash": "^2.0.2",
    "eslint": "^10.8.0",
    "jsdoc": "^4.0.5",
    "prettier": "^3.9.6"
  }
}
